# App
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-secret-please
ADMIN_PASSWORD=changeme123
# Public admin URL path (without slashes). Example: secret-panel → /secret-panel/login
ADMIN_PATH=admin
DATA_DIR=./data

# NOWPayments
# Local: leave API key empty to use demo checkout (NODE_ENV≠production).
# Production: set API key + IPN secret. Demo on public hosts needs NOWPAYMENTS_ALLOW_DEMO=true (not recommended).
NOWPAYMENTS_MODE=live
NOWPAYMENTS_ALLOW_DEMO=false
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_API_BASE=https://api.nowpayments.io

# Telegram (optional; can also set in /admin)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
