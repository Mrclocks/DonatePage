# App
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-secret-please
ADMIN_PASSWORD=changeme123
# Public admin URL path (without slashes). Example: secret-panel → /secret-panel/login
ADMIN_PATH=admin
DATA_DIR=./data

# OnePayment
# Local: MODE=demo is fine.
# Production: set API key + webhook secret. Demo on public hosts needs ONEPAYMENT_ALLOW_DEMO=true (not recommended).
ONEPAYMENT_MODE=demo
ONEPAYMENT_ALLOW_DEMO=false
ONEPAYMENT_API_KEY=
ONEPAYMENT_MERCHANT_ID=
ONEPAYMENT_WEBHOOK_SECRET=
ONEPAYMENT_API_BASE=https://api.onepayment.pro
ONEPAYMENT_CREATE_PATH=/v1/payments

# Telegram (optional; can also set in /admin)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
